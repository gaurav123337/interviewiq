# Environment reference — the values live in Supabase → Edge Functions →
# Secrets (never commit a real .env; .env is gitignored).
#
# Payment provider (default: razorpay)
PAYMENT_PROVIDER=razorpay
# INR while the Razorpay account is domestic-only; set back to USD once
# international payments are approved (or with a Razorpay International
# account). Prices come from app_config → pricing (admin-published).
PAYMENT_CURRENCY=INR
APP_URL=https://gaurav123337.github.io/interviewiq/

# Razorpay (test keys end in _test, live in _live)
#   Dashboard: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Any long random string — paste the SAME value as the webhook secret in the
# Razorpay dashboard → Settings → Webhooks (URL: <project>/functions/v1/pay-webhook)
RAZORPAY_WEBHOOK_SECRET=

# Stripe (drop-in alternative — only needed when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Refund email notifications (optional — app works without it)
#   https://resend.com → API Keys. Verify a domain to send branded email.
RESEND_API_KEY=

# Supabase (project URL + anon/publishable key — never the service role key)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
