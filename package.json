{
  "name": "interviewiq",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "InterviewIQ — AI interviewer PWA. Pick a level, field and company; get tailored interview questions with solutions, from junior developer to CEO.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json --noEmit && node scripts/check-no-innerhtml.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "eval:rag": "vitest run src/__tests__/rag-eval.test.ts",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icons.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@reduxjs/toolkit": "^2.12.0",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-query": "^5.101.4",
    "@types/react-redux": "^7.1.34",
    "codemirror": "^6.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
